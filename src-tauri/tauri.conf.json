{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "instagrab",
  "version": "0.1.0",
  "identifier": "space.emus.instagrab",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "instagrab",
        "width": 980,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://*.fbcdn.net https://*.cdninstagram.com data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"]
  }
}
